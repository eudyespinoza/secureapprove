# SecureApprove Environment Configuration

# Database Configuration
MONGODB_URI=mongodb://secureapprove:secure_password@mongodb:27017/secureapprove?replicaSet=rs0&authSource=admin
MONGODB_DB_NAME=secureapprove

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# WebAuthn Configuration
WEBAUTHN_RP_NAME=SecureApprove
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=https://localhost:3000
WEBAUTHN_EXPECTED_ORIGINS=https://localhost:3000,https://secureapprove.local

# API Configuration
API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGINS=https://localhost:3000,https://secureapprove.local

# Web App Configuration
NEXT_PUBLIC_API_URL=https://api.secureapprove.local
NEXT_PUBLIC_WS_URL=wss://api.secureapprove.local
NEXTAUTH_URL=https://secureapprove.local
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# Push Notifications
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_BUNDLE_ID=com.secureapprove.mobile
APNS_PRIVATE_KEY_PATH=/certs/apns-key.p8
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# SSL/TLS Configuration
SSL_CERT_PATH=/certs/cert.pem
SSL_KEY_PATH=/certs/key.pem
SSL_CA_PATH=/certs/ca.pem

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=secureapprove-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Production Flags
NODE_ENV=production
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
STRICT_SSL=true