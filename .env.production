# SecureApprove Production Environment Variables

# =====================================
# 🔴 CRITICAL: Change ALL these values in production!
# =====================================

# Domain Configuration
DOMAIN=secureapprove.com
ACME_EMAIL=admin@secureapprove.com

# Database Configuration (MongoDB Cluster)
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=YOUR_SECURE_MONGODB_ROOT_PASSWORD
MONGODB_USERNAME=secureapprove
MONGODB_PASSWORD=YOUR_SECURE_MONGODB_PASSWORD
MONGODB_DB_NAME=secureapprove

# Redis Configuration
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD

# Authentication & Security
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_MINIMUM_32_CHARACTERS
NEXTAUTH_SECRET=YOUR_SUPER_SECURE_NEXTAUTH_SECRET_MINIMUM_32_CHARACTERS
BCRYPT_ROUNDS=12

# WebAuthn Configuration
WEBAUTHN_RP_NAME=SecureApprove
# Note: RP_ID must match your domain
WEBAUTHN_RP_ID=secureapprove.com
WEBAUTHN_ORIGIN=https://secureapprove.com
WEBAUTHN_EXPECTED_ORIGINS=https://secureapprove.com

# API Configuration
API_CORS_ORIGINS=https://secureapprove.com

# Push Notifications
FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY
FCM_PROJECT_ID=your-firebase-project-id
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_BUNDLE_ID=com.secureapprove.mobile
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# AWS Configuration (for backups)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
BACKUP_S3_BUCKET=secureapprove-backups

# Monitoring & Logging
SENTRY_DSN=YOUR_SENTRY_DSN
GRAFANA_ADMIN_PASSWORD=YOUR_SECURE_GRAFANA_PASSWORD

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Traefik Configuration
TRAEFIK_AUTH=admin:$$2y$$10$$YOUR_BCRYPT_HASHED_PASSWORD

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Production Flags
NODE_ENV=production
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
STRICT_SSL=true