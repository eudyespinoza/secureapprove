# SecureApprove - Production Environment Variables
# Copy this file to .env and configure for your production environment

# =====================================
# 🔴 REQUIRED: Configure these values!
# =====================================

# Domain Configuration
DOMAIN=tu-servidor.com
ACME_EMAIL=admin@tu-servidor.com

# Database Configuration (MongoDB)
MONGODB_PORT=27018
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=SecureMongo123!
MONGODB_USERNAME=secureapprove
MONGODB_PASSWORD=SecureApp123!
MONGODB_DB_NAME=secureapprove

# Redis Configuration
REDIS_PASSWORD=SecureRedis123!

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long!
NEXTAUTH_SECRET=super-secret-nextauth-key-minimum-32-characters!

# WebAuthn Configuration
WEBAUTHN_RP_NAME=SecureApprove
WEBAUTHN_RP_ID=tu-servidor.com
WEBAUTHN_ORIGIN=https://tu-servidor.com
WEBAUTHN_EXPECTED_ORIGINS=https://tu-servidor.com

# API Configuration
API_CORS_ORIGINS=https://tu-servidor.com

# Push Notifications (Optional - can be empty for testing)
FCM_SERVER_KEY=
FCM_PROJECT_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.secureapprove.mobile
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AWS Configuration (Optional - can be empty for testing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BACKUP_S3_BUCKET=

# Monitoring & Logging (Optional)
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=admin123

# Traefik Configuration
TRAEFIK_AUTH=admin:$$2y$$10$$rO7YkAqQtOcFKc8zOaQu1eWGTfk8.k1kH6.8ghAGKnJ3xGzjB7V/.

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Production Flags
NODE_ENV=production
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
STRICT_SSL=false